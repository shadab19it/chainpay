# Copy this file to .env.local and fill in values:  cp .env.example .env.local
# NEVER commit .env.local. NEVER put real secrets in this file.
# Only variables starting with NEXT_PUBLIC_ are sent to the browser.

# Public (safe for the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — all optional at startup; required only when the feature that uses them runs
DATABASE_URL=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
SARVAM_API_KEY=
LLM_API_KEY=
